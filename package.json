{
  "name": "mac-mini-jarvis",
  "productName": "Mac Mini Jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "Local agent harness for Claude Code and Codex subscriptions",
  "author": "",
  "main": "out/main/boot.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "verify-package": "node scripts/verify-package.mjs",
    "doctor": "node scripts/doctor.mjs",
    "bench": "node scripts/bench.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run check && electron-vite build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@slack/bolt": "^5.1.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "dotenv": "^18.0.4",
    "undici": "7.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "1.95.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.macminijarvis.app",
    "productName": "Mac Mini Jarvis",
    "afterPack": "scripts/verify-package.mjs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "resources/updater",
        "to": "updater"
      }
    ],
    "asarUnpack": [
      "out/main/harness-mcp.js",
      "node_modules/better-sqlite3/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "LSUIElement": false,
        "NSAppleEventsUsageDescription": "Mac Mini Jarvis sends iMessages through Messages.app."
      }
    }
  },
  "license": "MIT"
}
